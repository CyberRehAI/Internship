# Virtual environments
**/otx_env/

# Node modules
**/node_modules/

# Python cache
**/__pycache__/
**/*.pyc

# IDE configs and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environments
**/.env
**/.env.*

# Large data files (OTX / OTX2)
**/*.jsonl
**/*.zip
**/*.csv

# JSON files (except configuration files)
**/*.json
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!**/tsconfig.*.json
!**/.oxlintrc.json
!**/checkpoint.json

# AI-TDP: allow project configs, schemas, metrics, and reports
!AI-TDP/
!AI-TDP/**/
!AI-TDP/**/*.json
!AI-TDP/**/*.csv
!AI-TDP/baselines/outputs/**/*
!AI-TDP/reports/**/*
!AI-TDP/behavior/outputs/**/*
